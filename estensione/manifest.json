{
  "manifest_version": 3,
  "name": "Compilatutto",
  "version": "2.0.3",
  "description": "Compila i moduli sui siti con i dati della tua famiglia, cifrati e salvati solo sul tuo computer.",
  "icons": { "16": "icone/icona-16.png", "32": "icone/icona-32.png", "48": "icone/icona-48.png", "128": "icone/icona-128.png" },
  "action": {
    "default_title": "Compilatutto",
    "default_popup": "popup.html",
    "default_icon": { "16": "icone/icona-16.png", "32": "icone/icona-32.png" }
  },
  "background": { "service_worker": "servizio.js" },
  "options_page": "impostazioni.html",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "alarms"],
  "host_permissions": ["https://manliograndi-del.github.io/*"],
  "commands": {
    "compila": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Compila la pagina con Compilatutto"
    }
  },
  "minimum_chrome_version": "116"
}
